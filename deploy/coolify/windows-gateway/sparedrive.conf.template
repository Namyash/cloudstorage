map $http_host $backend_host {
    default "";
    "127.0.0.1:${SPAREDRIVE_GATEWAY_PORT}" "127.0.0.1:${SPAREDRIVE_NATIVE_PORT}";
    "${SPAREDRIVE_HTTPS_HOST}" "${SPAREDRIVE_HTTPS_HOST}";
}

map $http_host $gateway_origin {
    default "";
    "127.0.0.1:${SPAREDRIVE_GATEWAY_PORT}" "http://127.0.0.1:${SPAREDRIVE_GATEWAY_PORT}";
    "${SPAREDRIVE_HTTPS_HOST}" "https://${SPAREDRIVE_HTTPS_HOST}";
}

map $http_host $backend_origin {
    default "";
    "127.0.0.1:${SPAREDRIVE_GATEWAY_PORT}" "http://127.0.0.1:${SPAREDRIVE_NATIVE_PORT}";
    "${SPAREDRIVE_HTTPS_HOST}" "https://${SPAREDRIVE_HTTPS_HOST}";
}

server {
    listen 8080 default_server;
    server_tokens off;
    access_log off;
    client_max_body_size 5m;

    location / {
        if ($backend_host = "") { return 421; }
        set $request_origin $http_origin;
        if ($request_origin = "") { set $request_origin $gateway_origin; }
        if ($request_origin != $gateway_origin) { return 403; }

        proxy_pass http://host.docker.internal:${SPAREDRIVE_NATIVE_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $backend_host;
        proxy_set_header Origin $backend_origin;
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Proto "";
        proxy_set_header X-Forwarded-For "";
        proxy_request_buffering off;
        proxy_buffering off;
    }
}
